# Copy this file to .env.local (already gitignored) and fill in real values.
# For production, set the same variable in your Vercel project settings.

# Local Docker Postgres (`npm run db:up`) — matches docker-compose.yml:
#   DATABASE_URL="postgres://site:devpassword@127.0.0.1:5432/site"
#   DATABASE_SSL="false"
# Hosted (Neon/Supabase/...): paste the provider's URL, keep DATABASE_SSL unset.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Random string mixed into the hashed client IP used for contact-form rate
# limiting (raw IPs are never stored). Generate with: openssl rand -hex 32
IP_HASH_SALT=""

# Optional — controls Pino's log verbosity (trace/debug/info/warn/error/fatal)
LOG_LEVEL="info"

# Optional — a Cal.com or Calendly scheduling link, embedded on /connect.
# NEXT_PUBLIC_ because it's read in the browser (iframe src), so it will be
# visible in client-side JS — fine for a public booking link.
NEXT_PUBLIC_BOOKING_URL="https://cal.com/your-username"

# Optional — Obsidian vault. By default the vault is this repo's `content/`
# folder (open it in Obsidian with "Open folder as vault"). Set this to use a
# vault somewhere else while developing locally; relative paths resolve from
# the project root. A production build reads whatever this points to at
# build time, so leave it unset on Vercel and keep the notes in `content/`.
# OBSIDIAN_VAULT_PATH="/Users/you/Documents/MyVault"

# Optional — the vault's name as shown in Obsidian. When set, each note page
# gets an "Open in Obsidian" link (obsidian://open?vault=...). Only useful if
# you want that link visible; visitors without the vault can't use it.
# OBSIDIAN_VAULT_NAME="MyVault"

# Optional — set to "false" to connect to Postgres without SSL (e.g. a
# Postgres container in Docker). Leave unset for hosted databases.
# DATABASE_SSL="false"
